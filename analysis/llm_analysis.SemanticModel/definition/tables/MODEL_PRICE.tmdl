table MODEL_PRICE
	lineageTag: 117375df-50d2-40ff-aaea-7bae03882351

	measure 'Celkový čas modelů (min)' = [Celkový čas extrakce modelů (min)] + [Celkový čas formalizace modelů (min)]
		lineageTag: cf0a0080-489b-4ade-a8c4-3ee10e88f8ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Celkový čas extrakce modelů (min)' =
			
			CALCULATE(
			    DIVIDE(SUM('EXTRACTION_RUN'[duration_ms]), 60000, 0),
			    FILTER(
			        'EXTRACTED_TEXT',
			        NOT(ISEMPTY('EXTRACTED_TEXT_EVAL') // vrátí všechny extrakční záznamy, ke kterým existuje hodnocení
			        )),
			    CALCULATETABLE(VALUES('DOCUMENT'[id]), 'MODEL'[name] = "human")
			)
		lineageTag: 333fd268-3e06-432c-8c79-83525800bf02

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Celkový čas formalizace modelů (min)' =
			
			CALCULATE(
			    DIVIDE(SUM('ANALYZED_TEXT'[duration_ms]), 60000, 0),
			    FILTER('ANALYZED_TEXT', NOT(ISEMPTY('ANALYZED_TEXT_EVAL'))),
			    'MODEL'[name] = "human"
			) // celkový čas ze všech formalizačních záznamů, které byly provedeny nad golden extrakčními záznamy; počítá se pouze z hodnocených
		lineageTag: b3c37c78-13c1-42e5-b8b4-a51d62d3f1bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Celková cena extrakce (CZK)' =
			
			CALCULATE(
			    SUMX(
			        'EXTRACTION_RUN',
			        DIVIDE('EXTRACTION_RUN'[input_tokens], 1000000) * LOOKUPVALUE('MODEL_PRICE'[input_price_1M_USD], 'MODEL_PRICE'[model_id], 'EXTRACTION_RUN'[model_id]) +
			        DIVIDE('EXTRACTION_RUN'[output_tokens], 1000000) * LOOKUPVALUE('MODEL_PRICE'[output_price_1M_USD], 'MODEL_PRICE'[model_id], 'EXTRACTION_RUN'[model_id])
			    ),
			    FILTER(
			        'EXTRACTED_TEXT',
			        NOT(ISEMPTY('EXTRACTED_TEXT_EVAL')) // vyfiltruje všechny extrakční záznamy, které mají ohodnocení
			    )
			) * [Kurz z USD na CZK]
		lineageTag: f2f123b8-fe41-4513-a443-c572126cfad9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Celková cena LLM (CZK)' = [Celková cena extrakce (CZK)] + [Celková cena formalizace (CZK)]
		lineageTag: 729f6c7d-deb0-4077-a989-7c78feb3d32d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Celková cena formalizace (CZK)' =
			
			CALCULATE(
			    SUMX(
			        'ANALYZED_TEXT',
			        DIVIDE('ANALYZED_TEXT'[input_tokens], 1000000) * LOOKUPVALUE('MODEL_PRICE'[input_price_1M_USD], 'MODEL_PRICE'[model_id], 'ANALYZED_TEXT'[model_id]) +
			        DIVIDE('ANALYZED_TEXT'[output_tokens], 1000000) * LOOKUPVALUE('MODEL_PRICE'[output_price_1M_USD], 'MODEL_PRICE'[model_id], 'ANALYZED_TEXT'[model_id])
			    ),
			    FILTER('ANALYZED_TEXT', NOT(ISEMPTY('ANALYZED_TEXT_EVAL'))),
			    'MODEL'[name] = "human"
			) * [Kurz z USD na CZK] // cena se počítá jen z formalizačních záznamů vytvořené nad golden extrakčními záznamy; počítá se pouze ze záznamů, které jsou ohodnocené
		lineageTag: ab8afd58-c009-4ce4-88e6-de2c05200e37

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Průměrná cena extrakce za kus (CZK)' = DIVIDE([Celková cena extrakce (CZK)], CALCULATE(COUNTROWS('EXTRACTION_RUN'), FILTER('EXTRACTED_TEXT', NOT(ISEMPTY('EXTRACTED_TEXT_EVAL'))))) // cena se počítá pouze z evaluovaných záznamů
		lineageTag: 591af509-e96e-4b97-ba2b-2e0504f35c82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Průměrná cena formalizace za kus (CZK)' = ```
			
			DIVIDE(
			    [Celková cena formalizace (CZK)], 
			    CALCULATE(
			        COUNTROWS('ANALYZED_TEXT'), 
			        FILTER('ANALYZED_TEXT', NOT(ISEMPTY('ANALYZED_TEXT_EVAL'))),
			        'MODEL'[name] = "human"
			    )
			)
			 // průměrná cena se počítá pouze z formalizačních záznamů z takových extrakčních, ke kterým existuje golden dataset; pouze pro ohodnocené záznamy
			```
		lineageTag: 6ea1311b-2b5e-4feb-9a4b-f62f3e723d2f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ušetřenné peníze (CZK)' = [Celková cena člověka (CZK)] - [Celková cena LLM (CZK)]
		lineageTag: 206242e9-cc75-4dbb-bb42-29821540e787

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Graf_Cena_Extrakce = ```
			
			VAR VybranyModel = SELECTEDVALUE('SPOLECNE_MODELY'[name])
			RETURN
			IF(
			    VybranyModel <> "human", 
			    CALCULATE([Celková cena extrakce (CZK)], 'MODEL'[name] = VybranyModel), 
			    BLANK()
			)
			```
		lineageTag: bb540e36-ade8-4610-b8c4-338b0f342df1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Graf_Cena_Formalizace =
			
			VAR VybranyModel = SELECTEDVALUE('SPOLECNE_MODELY'[name])
			RETURN
			IF(
			    VybranyModel <> "human",
			    CALCULATE([Celková cena formalizace (CZK)], 'DIM_MODEL_ANALYSIS'[name] = VybranyModel),
			    BLANK()
			)
		lineageTag: 429d64d3-e7fe-4176-a217-4e9f74e5ea62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Graf_Cena_Clovek = ```
			
			VAR VybranyModel = SELECTEDVALUE('SPOLECNE_MODELY'[name])
			VAR Volba = SELECTEDVALUE('Switch_human_summary'[Show_human], "Ano")
			RETURN
			IF(
			    VybranyModel = "human" && Volba = "Ano", 
			    [Celková cena člověka (CZK)], 
			    BLANK()
			)
			```
		lineageTag: 54b7bb52-7108-408c-9a08-6e89d82a08b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Graf_Cas_Celkem =
			
			VAR VybranyModel = SELECTEDVALUE('SPOLECNE_MODELY'[name])
			VAR Volba = SELECTEDVALUE('Switch_human_summary'[Show_human], "Ano")
			
			VAR CasExtrakce = CALCULATE([Celkový čas extrakce modelů (min)], 'MODEL'[name] = VybranyModel)
			VAR CasFormalizace = CALCULATE([Celkový čas formalizace modelů (min)], 'DIM_MODEL_ANALYSIS'[name] = VybranyModel)
			
			RETURN
			IF(
			    VybranyModel = "human",
			    IF(Volba = "Ano", [Celkový čas člověka (min)], BLANK()),
			    CasExtrakce + CasFormalizace
			)
		lineageTag: a83ada7a-e023-437b-8064-647bdcc09275

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Průměrná cena extrakce (na jeden model)' = ```
			
			
			AVERAGEX(
			    VALUES('MODEL'[name]), 
			    [Průměrná cena extrakce za kus (CZK)]
			)
			```
		lineageTag: 90cd97d4-890d-4ae7-91f9-b919f46026e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Průměrná cena formalizace (na jeden model)' = ```
			
			
			AVERAGEX(
			    VALUES('DIM_MODEL_ANALYSIS'[name]), 
			    [Průměrná cena formalizace za kus (CZK)]
			)
			```
		lineageTag: 5f1491d4-cbfd-46ba-8a18-727bb2e7bf00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Kurz z USD na CZK' = 21.24
		lineageTag: b1dd85e8-3746-4095-b134-99be196c979d

