	measure 'Průměrný čas extrakce modelů za dokument (min)' = ```
			
			DIVIDE(
			    [Celkový čas extrakce modelů (min)], 
			    CALCULATE(
			        COUNTROWS('EXTRACTION_RUN'), 
			        FILTER(
			            'EXTRACTED_TEXT',
			            NOT(ISEMPTY('EXTRACTED_TEXT_EVAL'))
			        )
			    )
			) // průměrný čas extrakce modelů jen z ohodnocených záznamů
			```
		lineageTag: 36e00a9b-8fc7-44fd-8b1d-c0106148b217

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Průměrný čas formalizace modelů za požadavek (min)' = ```
			
			DIVIDE(
			    [Celkový čas formalizace modelů (min)], 
			    CALCULATE(
			        COUNTROWS('ANALYZED_TEXT'), 
			        FILTER('ANALYZED_TEXT', NOT(ISEMPTY('ANALYZED_TEXT_EVAL'))),
			        'MODEL'[name] = "human"
			    )
			) // celkový čas se počítá z analyzed_text záznamů, které byly vytvořeny nad extrakčními golden záznamy; pouze pro záznamy, ke kterým funguje hodnocení
			```
		lineageTag: 87f8836e-f691-49c5-af0e-0eb149a9e358

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sdruzeny_Cas_Modelu = ```
			
			VAR VybranyModel = SELECTEDVALUE('SPOLECNE_MODELY'[name])
			
			VAR CasExtrakce = 
			    CALCULATE(
			        [Celkový čas extrakce modelů (min)],
			        'MODEL'[name] = VybranyModel
			    )
			
			VAR CasFormalizace = 
			    CALCULATE(
			        [Celkový čas formalizace modelů (min)],
			        'DIM_MODEL_ANALYSIS'[name] = VybranyModel
			    )
			
			RETURN 
			CasExtrakce + CasFormalizace
			```
		lineageTag: 9d115fad-71b8-4538-87c3-1dcaac8068a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Průměrný čas extrakce modelů za dokument (s)' = [Průměrný čas extrakce modelů za dokument (min)] * 60
